---
import "../styles/global.css";
import { Font } from "astro:assets";

interface Props {
  title?: string;
  description?: string;
  /** Absolute or site-relative URL of the social preview image. */
  image?: string;
  /** Set on pages that should not be indexed (e.g. the styleguide). */
  noindex?: boolean;
  /**
   * Translations of this page, for hreflang. Omit an entry when no translation
   * exists — 5 blog posts have no English version, and pointing hreflang at a
   * page that was never built is worse than omitting it.
   */
  alternates?: { locale: string; url: string }[];
}

const { title, description, image, noindex = false, alternates = [] } = Astro.props;

const lang = Astro.currentLocale === "en" ? "en" : "de";

const SITE_NAME = "D‑LABS GmbH";
const pageTitle = title ? `${title} | ${SITE_NAME}` : SITE_NAME;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    {/* Astro emits the @font-face rules, fallback metrics and preload hints. */}
    <Font cssVariable="--font-letter-gothic" preload />
    <Font cssVariable="--font-roboto" preload />

    <title>{pageTitle}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical.href} />
    {
      alternates.map((alt) => (
        <link rel="alternate" hreflang={alt.locale} href={new URL(alt.url, Astro.site).href} />
      ))
    }
    {alternates.length > 0 && <link rel="alternate" hreflang={lang} href={canonical.href} />}
    {noindex && <meta name="robots" content="noindex,nofollow" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content={lang === "de" ? "de_DE" : "en_US"} />
    <meta property="og:title" content={title ?? SITE_NAME} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonical.href} />
    {image && <meta property="og:image" content={new URL(image, Astro.site).href} />}
    <meta name="twitter:card" content={image ? "summary_large_image" : "summary"} />
  </head>

  <body class="flex min-h-screen flex-col">
    <main class="flex-auto">
      <slot />
    </main>
  </body>
</html>
