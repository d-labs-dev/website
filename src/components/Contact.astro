---
/**
 * Contact block: a named person with their photo and details, plus a link
 * through to the office addresses. Used at the foot of the jobs and approach
 * pages.
 *
 * The avatar is referenced by filename in the page YAML, so the images are
 * imported here through a glob rather than by a literal path — content should
 * not have to know where the assets directory is.
 */
import { Image } from "astro:assets";
import Button from "@/components/Button.astro";
/*
 * Inlined, not an <Image>: the original drops this SVG straight into the heading
 * as inline content, so it sits on the text baseline and its line box sets the
 * heading's height. A flex row with a block <img> made the link 3px shorter than
 * live below 800px, where the icon is no longer the tallest thing in the row.
 *
 * No size class either: the file carries `width="30.975" height="30.975"` and
 * nothing on live overrides them, so the mark is a fixed 31px at every width —
 * not 1.5rem, which shrinks with the fluid root.
 */
import ArrowUpRight from "@/assets/images/icons/icon-arrow-right-up.svg";
import { pageUrl, type Locale } from "@/lib/i18n";

export interface ContactDetails {
  title: string;
  name: string;
  position: string;
  email: string;
  tel?: string;
  mobile?: string;
  cta_text?: string;
  our_locations?: string;
  avatar_img: string;
}

interface Props {
  locale: Locale;
  contact: ContactDetails;
  /** Light variant, on white rather than blue. */
  light?: boolean;
  /** The job page shows the details without the mail button. */
  withButton?: boolean;
}

const { locale, contact, light = false, withButton = true } = Astro.props;

const avatars = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/images/**/*.{jpg,jpeg,png,webp}",
  { eager: true },
);
const avatarPath = `/src/assets/images/${contact.avatar_img}`;
const avatar = avatars[avatarPath]?.default;

if (!avatar) {
  throw new Error(`Contact avatar not found: ${avatarPath}. Check avatar_img in the page's YAML.`);
}
---

<div
  class:list={[
    "flex flex-col items-center gap-6 px-6 pt-16 pb-24",
    light ? "bg-white text-black" : "bg-dlabs-blue text-white",
  ]}
>
  <div class="flex w-full max-w-[60rem] flex-col gap-12 pb-6 lg:flex-row lg:gap-4 lg:pb-0">
    <h2 class="font-heading tracking-heading max-w-[30rem] text-xl">{contact.title}</h2>

    <div class="hidden flex-auto md:block"></div>

    <div class="flex flex-col items-center gap-8 sm:flex-row sm:items-start">
      <Image
        src={avatar}
        alt={`${contact.name}`}
        width={288}
        height={288}
        class="h-32 w-32 shrink-0 rounded-full object-cover"
        loading="lazy"
      />

      <div class="flex flex-col gap-6">
        <div class="flex flex-col">
          <div class="font-bold">{contact.name}</div>
          <div class="text-sm">{contact.position}</div>
        </div>

        <div class="flex flex-col text-sm">
          {contact.tel && <div>T {contact.tel}</div>}
          {contact.mobile && <div>M {contact.mobile}</div>}
          <a class="contact-mail" href={`mailto:${contact.email}`}>{contact.email}</a>
        </div>

        {
          withButton && contact.cta_text && (
            <div class="flex flex-col items-start">
              <Button
                variant="solid"
                color={light ? "blue" : "white"}
                href={`mailto:${contact.email}`}
              >
                {contact.cta_text}
              </Button>
            </div>
          )
        }
      </div>
    </div>
  </div>

  {
    contact.our_locations && (
      <a
        href={`${pageUrl("about", locale)}#locations`}
        class:list={["locations-link w-full max-w-[60rem]", light ? "is-light" : "is-dark"]}
      >
        <h2 class="font-heading tracking-heading max-w-[30rem] text-xl">
          {contact.our_locations}{" "}
          <ArrowUpRight class="inline fill-current align-baseline" aria-hidden="true" />
        </h2>
      </a>
    )
  }
</div>

<style>
  .contact-mail {
    color: inherit;
    text-decoration: none;
  }

  .contact-mail:hover {
    text-decoration: underline;
  }

  /*
   * `.header-link` on the original, which is where the 2px of top padding and the
   * transparent 2px rule come from — 4px of height this link was missing.
   */
  .locations-link {
    padding-top: 2px;
    border-bottom: 2px solid transparent;
    text-decoration: none;
    transition-property: color, opacity;
  }

  .locations-link.is-dark {
    color: #fff;
  }

  .locations-link.is-dark:hover {
    color: var(--color-white-a90);
  }

  .locations-link.is-light {
    color: var(--color-black);
  }

  .locations-link.is-light:hover {
    color: var(--color-dlabs-blue);
  }
</style>
