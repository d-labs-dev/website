---
/**
 * Fixed site header with the main nav, the rotated JOBS badge, a language
 * switcher and a full-screen mobile menu.
 *
 * Two stateful behaviours, both from the old `_header.scss` + `headerScroll()`:
 *
 *  - `blueOnTop` (was `body.with-blue-header`, set only by the home layout):
 *    the bar starts transparent-over-blue with white text and an inverted logo,
 *    then flips to the normal white bar once you've scrolled about a screen.
 *  - the JOBS item renders as a tilted blue circle — but on a blue header it
 *    stays a plain link until that flip, otherwise blue-on-blue would vanish.
 *
 * The scroll flip is a `data-scrolled` attribute set by ./header.ts. Those two
 * states need a pseudo-element and a filter, so this component carries a scoped
 * <style> rather than doing it all with utilities.
 */
import { Image } from "astro:assets";
import dlabsLogo from "@/assets/images/logo_d-labs.svg";
import menuIcon from "@/assets/images/icons/icon-menu.svg";
import closeIcon from "@/assets/images/icons/icon-close.svg";
import {
  NAV_ITEMS,
  pageUrl,
  otherLocale,
  LOCALE_NAMES,
  getSharedCopy,
  type Locale,
} from "@/lib/i18n";

interface Props {
  locale: Locale;
  /** Ref of the current page, so its nav item can be marked active. */
  activeRef?: string;
  /** Where the language switcher points. */
  switcherUrl: string;
  /** Home page only: start over the blue hero. */
  blueOnTop?: boolean;
}

const { locale, activeRef, switcherUrl, blueOnTop = false } = Astro.props;

const labels = await getSharedCopy("header", locale);
const target = otherLocale(locale);

const nav = NAV_ITEMS.map((ref) => ({
  ref,
  label: labels[ref] ?? ref,
  href: pageUrl(ref, locale),
  isActive: ref === activeRef,
  isBadge: ref === "jobs",
}));
---

<header
  class="site-header fixed top-0 z-10 flex w-full flex-col items-center bg-white px-6 py-6"
  data-site-header
  data-blue-top={blueOnTop ? "" : undefined}
>
  <div class="flex w-full max-w-[60rem] flex-row items-center gap-4">
    <a href={pageUrl("home", locale)} aria-label="D-LABS">
      <Image src={dlabsLogo} alt="D-LABS" class="site-logo h-4 w-auto" loading="eager" />
    </a>

    <div class="flex-auto"></div>

    {
      /*
      `md:mr-4` reproduces a quirk of the old layout that is nonetheless the
      live site's geometry: the shell used a spacing helper that put a 1rem
      right margin on every child except the last, and the last child is the
      hidden burger button — so the desktop nav sits 1rem short of the container
      edge while the logo is flush to it.
    */
    }
    <nav class="hidden flex-row items-baseline gap-16 md:mr-4 md:flex" aria-label="Hauptnavigation">
      <div class="flex flex-row items-baseline gap-8 lg:gap-12">
        {
          nav.map((item) => (
            <a
              href={item.href}
              class="nav-link text-xs font-bold"
              data-badge={item.isBadge ? "" : undefined}
              data-active={item.isActive ? "" : undefined}
              aria-current={item.isActive ? "page" : undefined}
            >
              {/*
                The label is wrapped so the badge can carry its own underline.
                The anchor's blue rule would be invisible on the blue disc, so on
                the jobs page the original marks the *label* instead, in white —
                `is-active-badge-text` in locale_link_tag.rb.
              */}
              <div class="nav-label">{item.label}</div>
            </a>
          ))
        }
      </div>

      <a
        href={switcherUrl}
        class="lang-link text-2xs font-bold"
        title={LOCALE_NAMES[target]}
        hreflang={target}>{target}</a
      >
    </nav>

    <div class="md:hidden">
      <button
        type="button"
        class="menu-button"
        data-menu-open
        aria-controls="mobile-nav"
        aria-expanded="false"
      >
        {
          /* No size class: the icons are intrinsically 24x24 and the old markup's
            `h-2` matched no rule, so live renders them at that size. */
        }
        <Image src={menuIcon} alt="Menü öffnen" />
      </button>
    </div>
  </div>
</header>

{
  /*
  No `hidden` class: the overlay fades, and `display: none` cannot be animated.
  `data-open` drives it instead — see `.mobile-nav` below.
*/
}
<div class="mobile-nav fixed inset-0 z-20 bg-white" id="mobile-nav" data-mobile-nav>
  <div class="relative flex h-full w-full flex-col items-center px-8 py-6">
    <div class="absolute top-6 right-6">
      <button type="button" class="close-button" data-menu-close aria-label="Menü schließen">
        <Image src={closeIcon} alt="" />
      </button>
    </div>

    <div class="flex-auto"></div>

    <nav class="flex flex-col items-center gap-6" aria-label="Hauptnavigation">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class="nav-link text-base font-bold"
            data-active={item.isActive ? "" : undefined}
            aria-current={item.isActive ? "page" : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    {
      /*
      A growing spacer, not a fixed gap. The old markup's `push maxheight-1`
      resolves to just `push` (there is no `maxheight-*` family), so the overlay
      has three equal spacers and the nav and language switcher sit at the
      one-third marks rather than adjacent.
    */
    }
    <div class="flex-auto"></div>

    <a
      href={switcherUrl}
      class="lang-link text-sm font-bold"
      title={LOCALE_NAMES[target]}
      hreflang={target}>{target}</a
    >

    <div class="flex-auto"></div>
  </div>
</div>

<style>
  @reference "../styles/global.css";

  /*
   * The overlay fades over 250ms, as `toggleButton()` does: the burger carries no
   * `data-toggle-style`, so it falls through to jQuery's `fadeToggle(250)`.
   *
   * `visibility` rather than `display`, because display cannot be animated — and
   * unlike opacity alone it also takes the closed overlay out of the tab order
   * and stops it swallowing clicks. It flips at the end of the fade-out and the
   * start of the fade-in, which is what fadeToggle does with display.
   */
  /*
   * `ease-in-out`, not the site's usual `ease-out`: jQuery's default easing is
   * `swing`, a cosine curve. At 80ms of 250ms it is 0.23 — measured 0.21 on
   * live — where ease-out is already at 0.49.
   *
   * Visibility is switched instantly on the way in and held to the end of the
   * fade on the way out. Transitioning it symmetrically looks the same but
   * leaves the overlay `visibility: hidden` for the first half of the fade-in,
   * and a hidden element cannot take focus — so `focus()` on the first link
   * silently did nothing and the keyboard was left on <body>.
   */
  .mobile-nav {
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 250ms ease-in-out,
      visibility 0s linear 250ms;
  }

  .mobile-nav[data-open] {
    opacity: 1;
    visibility: visible;
    transition:
      opacity 250ms ease-in-out,
      visibility 0s;
  }

  .site-header {
    border-top: 0.1rem solid var(--color-dlabs-blue);
    transition-property: padding, box-shadow, background-color;
  }

  .site-logo,
  .menu-button {
    filter: grayscale(0) brightness(1);
    transition-property: filter;
  }

  /*
   * `.button-text`: a block button with a 0.2rem hit area that the negative
   * margin keeps out of the layout. Block matters here — a default-inline button
   * sits in a line box, which made the header 81px tall against live's 73.
   */
  .menu-button,
  .close-button {
    display: block;
    padding: 0.2rem;
    margin: -0.2rem;
    cursor: pointer;
  }

  .nav-link {
    padding-top: 2px;
    border-bottom: 2px solid transparent;
    color: var(--color-black);
    text-decoration: none;
    transition-property: color, border-color;
  }

  .nav-link:hover {
    color: var(--color-dlabs-blue);
  }

  .nav-link[data-active] {
    border-bottom-color: var(--color-dlabs-blue);
  }

  /*
   * Uppercased here rather than with the utility: the old
   * `.lang-switcher-link` set text-transform in CSS and no letter-spacing, so
   * it is one of the few uppercase things on the site that is *not* tracked at
   * 0.1em. Using the utility would pick that tracking up.
   */
  .lang-link {
    text-transform: uppercase;
    color: var(--color-dlabs-blue);
    text-decoration: none;
    transition-property: color;
  }

  .lang-link:hover {
    color: var(--color-dlabs-dark-blue);
  }

  /*
   * The JOBS badge: a tilted blue disc behind the label. Shown whenever the
   * header is white — i.e. always, except while a blue header is still at the
   * top of the page.
   */
  .site-header:not([data-blue-top]) .nav-link[data-badge],
  .site-header[data-blue-top][data-scrolled] .nav-link[data-badge] {
    position: relative;
    transform: rotate(15deg);
    color: #fff;
    font-size: var(--text-2xs);
    font-weight: normal;
    text-transform: uppercase;
    border-bottom-color: transparent;
  }

  /* The active jobs badge underlines its label in white. */
  /* A block element, as the original's is: an inline span's rule would not add
     its 2px to the anchor's height, and the badge would sit 2px short. */
  .nav-link[data-badge][data-active] .nav-label {
    border-bottom: 2px solid #fff;
  }

  .site-header:not([data-blue-top]) .nav-link[data-badge]::before,
  .site-header[data-blue-top][data-scrolled] .nav-link[data-badge]::before {
    content: "";
    position: absolute;
    top: -1.15rem;
    left: -0.9rem;
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 50%;
    background-color: var(--color-dlabs-blue);
    z-index: -1;
    transition-property: background-color;
  }

  .site-header:not([data-blue-top]) .nav-link[data-badge]:hover::before,
  .site-header[data-blue-top][data-scrolled] .nav-link[data-badge]:hover::before {
    background-color: var(--color-dlabs-dark-blue);
  }

  .site-header:not([data-blue-top]) .nav-link[data-badge][data-active],
  .site-header[data-blue-top][data-scrolled] .nav-link[data-badge][data-active] {
    border-bottom: 2px solid #fff;
  }

  /* Blue header, before the scroll flip. */
  .site-header[data-blue-top]:not([data-scrolled]) {
    background-color: var(--color-dlabs-blue);
  }

  .site-header[data-blue-top]:not([data-scrolled]) .nav-link,
  .site-header[data-blue-top]:not([data-scrolled]) .lang-link {
    color: #fff;
  }

  .site-header[data-blue-top]:not([data-scrolled]) .site-logo,
  .site-header[data-blue-top]:not([data-scrolled]) .menu-button {
    filter: grayscale(1) brightness(10);
  }
</style>

<script>
  import { setupHeader } from "./header";
  setupHeader();
</script>
