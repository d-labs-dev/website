---
/**
 * Client logo grid. Twelve show by default; the rest expand on request.
 *
 * The hidden logos are in the HTML rather than fetched, so the expand is
 * instant and the names are indexable. `hidden` on the group is enough — the
 * images inside are lazy, so nothing is downloaded until they are revealed.
 */
import { getEntry } from "astro:content";
import { Image } from "astro:assets";
import Button from "@/components/Button.astro";
/*
 * Inlined, not an <Image>: the file carries `fill: currentColor`, so on the
 * original this mark takes its link's colour and follows it on hover. An <img>
 * cannot inherit `color`, which left every one of these stuck at its rest shade.
 */
import ArrowDown from "@/assets/images/icons/icon-arrow-down.svg";

interface Props {
  heading: string;
  showMore: string;
  showLess: string;
}

const { heading, showMore, showLess } = Astro.props;

const entry = await getEntry("clients", "clients");
const first = entry?.data.first ?? [];
const rest = entry?.data.rest ?? [];

const logos = import.meta.glob<{ default: ImageMetadata }>("/src/assets/images/clients/*.svg", {
  eager: true,
});

function resolve(path: string) {
  const logo = logos[`/src/assets/images/${path}`]?.default;
  if (!logo) throw new Error(`Client logo not found: src/assets/images/${path}`);
  return logo;
}
---

<div
  class="relative z-2 flex flex-col items-center bg-white px-6 pt-24 pb-24"
  id="clients"
  data-client-grid
>
  <div class="flex w-full max-w-[60rem] flex-col gap-8">
    <h2 class="font-heading tracking-heading text-xl">{heading}</h2>

    {
      /*
      2-up below 800px and 4-up above, with 1.5rem of padding on each side of a
      cell and 1rem above and below — the original's `width-1_4 px-4 py-3
      q-lg-width-1_2`.

      `w-full` and no height cap: the old markup's `full-width maxheight-6` match
      no rule, but these SVGs declare no width either, so a bare <img> defaults
      to 100% of its box — which is what live renders (230x152 in a 230px cell).
      Astro's <Image> writes intrinsic width/height attributes, so without
      `w-full` each logo comes out a few pixels smaller than production.
    */
    }
    <div class="flex flex-row flex-wrap">
      {
        first.map((client) => (
          <div class="flex w-1/2 items-center justify-center px-6 py-4 md:w-1/4">
            <Image
              src={resolve(client.logo)}
              alt={client.name}
              title={client.name}
              class="w-full"
              loading="lazy"
            />
          </div>
        ))
      }
    </div>

    <div class="hidden" data-client-rest>
      <div class="flex flex-row flex-wrap">
        {
          rest.map((client) => (
            <div class="flex w-1/2 items-center justify-center px-6 py-4 md:w-1/4">
              <Image
                src={resolve(client.logo)}
                alt={client.name}
                title={client.name}
                class="w-full"
                loading="lazy"
              />
            </div>
          ))
        }
      </div>
    </div>

    {
      /*
      A text button with a caret, as on live — `button-text is-blue`, not a ghost
      button with a border, which stood 36px taller. The caret flips when the rest
      of the grid is showing, which is what the original did by swapping two
      hidden copies of the button's contents.
    */
    }
    {
      rest.length > 0 && (
        <div class="flex flex-col items-center">
          <Button
            variant="text"
            color="blue"
            data-client-toggle
            data-label-more={showMore}
            data-label-less={showLess}
            aria-expanded="false"
            aria-controls="client-rest"
          >
            <span class="flex flex-row items-center gap-4">
              <ArrowDown
                class="w-4 fill-current transition-transform"
                data-client-caret
                aria-hidden="true"
              />
              <span data-client-label>{showMore}</span>
            </span>
          </Button>
        </div>
      )
    }
  </div>
</div>

<script>
  import { setupClientGrid } from "./client-grid";
  setupClientGrid();
</script>
