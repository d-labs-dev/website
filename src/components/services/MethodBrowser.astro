---
/**
 * Browse the method library: filter by competence field, or search free-text.
 *
 * Every tile is rendered server-side and filtering only toggles visibility. That
 * is deliberate — these are 56 real content pages and their titles and
 * descriptions need to be in the HTML for search engines, so the list cannot be
 * built client-side.
 */
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import LeadLine from "@/components/LeadLine.astro";
import Markdown from "@/components/Markdown.astro";
import searchIcon from "@/assets/images/icons/icon-search.svg";
import caretDown from "@/assets/images/icons/icon-caret-down.svg";
import { contentfulImage, assetAlt } from "@/lib/contentful-image";
import { entryUrl, type Locale } from "@/lib/i18n";

interface Props {
  locale: Locale;
  methods: CollectionEntry<"methods">[];
  /** Competence fields, in the services page's order. Must match Contentful domain titles. */
  domains: { name: string; color: string }[];
  copy: {
    services_title: string;
    services_all_button: string;
    filter_button_label: string;
    search_placeholder?: string;
  };
}

const { locale, methods, domains, copy } = Astro.props;

/**
 * The filter matches a method's `domains` — which are Contentful domain titles —
 * against these names. If someone renames a domain in Contentful without
 * updating the services YAML, filtering silently matches nothing, so fail the
 * build instead.
 */
const knownDomains = new Set(methods.flatMap((m) => m.data.domains));
const unmatched = domains.map((d) => d.name).filter((name) => !knownDomains.has(name));
if (unmatched.length > 0 && knownDomains.size > 0) {
  throw new Error(
    `Services page filter names do not match any Contentful domain title: ${unmatched.join(", ")}. ` +
      `Known domains: ${[...knownDomains].sort().join(", ")}. ` +
      `Fix slides[].name in content/pages/${locale}/services.yml or the domain title in Contentful.`,
  );
}

const CIRCLE_COLOURS: Record<string, string> = {
  blue: "bg-dlabs-blue",
  yellow: "bg-dlabs-yellow",
  darkBlue: "bg-dlabs-dark-blue",
  red: "bg-dlabs-red",
  green: "bg-dlabs-green",
  purple: "bg-dlabs-purple",
};

const TILE_WIDTH = 400;
const TILE_HEIGHT = 300;
---

<div class="flex flex-col items-center px-6 pb-16" id="list" data-method-browser>
  <div class="flex w-full max-w-[60rem] flex-col gap-3 md:gap-12">
    {/* Sticky toolbar */}
    <div class="sticky top-24 z-2 flex flex-col gap-1 bg-white pt-24 pb-2 md:gap-6">
      <div class="flex flex-col items-stretch gap-3 md:flex-row md:items-end">
        <LeadLine as="h2">{copy.services_title}</LeadLine>

        <div class="hidden flex-auto md:block"></div>

        <div class="relative hidden" data-search-field style="margin-bottom: 0.3rem">
          <input
            type="search"
            class="search-input w-full md:w-auto"
            placeholder={copy.search_placeholder}
            aria-label={copy.search_placeholder ?? copy.services_title}
            data-search-input
          />
        </div>

        <div class="flex flex-row gap-3">
          <div class="flex flex-1 flex-col md:hidden">
            <button type="button" class="toolbar-button flex-1" data-filter-toggle>
              <span class="flex flex-row items-center gap-2 px-3 py-1">
                <span data-filter-label>{copy.filter_button_label}</span>
                <Image src={caretDown} alt="" class="w-3" />
              </span>
            </button>
          </div>
          <button
            type="button"
            class="toolbar-button"
            data-search-toggle
            aria-label={copy.search_placeholder ?? "Search"}
          >
            <span class="flex px-2 py-1"><Image src={searchIcon} alt="" class="w-4" /></span>
          </button>
        </div>
      </div>

      <div class="hidden pt-4 pb-2 md:block" data-filter-panel>
        <div class="flex flex-col items-start justify-center gap-3 md:flex-row md:gap-4">
          <button type="button" class="filter" data-filter="" data-active>
            <span class="flex flex-row items-start gap-2">
              <span class="w-3 shrink-0"
                ><span class="bg-dlabs-blue block h-3 w-3 rounded-full"></span></span
              >
              <span class="text-xs">{copy.services_all_button}</span>
            </span>
          </button>

          {
            domains.map((domain) => (
              <button type="button" class="filter" data-filter={domain.name}>
                <span class="flex flex-row items-start gap-2">
                  <span class="w-3 shrink-0">
                    <span
                      class:list={[
                        "block h-3 w-3 rounded-full",
                        CIRCLE_COLOURS[domain.color] ?? "bg-dlabs-blue",
                      ]}
                    />
                  </span>
                  <span class="text-xs">{domain.name}</span>
                </span>
              </button>
            ))
          }
        </div>
      </div>
    </div>

    {/* Tiles */}
    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 md:grid-cols-3 md:gap-12">
      {
        methods.map((method) => (
          <div
            class="flex flex-col gap-6"
            data-method-tile
            data-domains={method.data.domains.join("|")}
          >
            <a
              href={entryUrl("methods", method.data.slug, locale)}
              tabindex="-1"
              aria-hidden="true"
            >
              {method.data.heroImage && (
                <img
                  src={contentfulImage(method.data.heroImage, {
                    width: TILE_WIDTH,
                    height: TILE_HEIGHT,
                    fit: "fill",
                    focus: "faces",
                  })}
                  alt={assetAlt(method.data.heroImage)}
                  width={TILE_WIDTH}
                  height={TILE_HEIGHT}
                  class="w-full"
                  loading="lazy"
                />
              )}
            </a>
            <div class="flex flex-col gap-4">
              <a href={entryUrl("methods", method.data.slug, locale)} class="tile-link">
                <h3 class="text-base font-bold" data-search-text>
                  {method.data.title}
                </h3>
              </a>
              <div data-search-text>
                <Markdown source={method.data.description} size="sm" />
              </div>
            </div>
          </div>
        ))
      }
    </div>

    <p class="text-dlabs-gray-300 hidden py-12 text-center text-sm" data-empty-state>
      {locale === "de" ? "Keine Treffer." : "No matches."}
    </p>
  </div>
</div>

<style>
  .search-input {
    border: none;
    border-bottom: 2px solid var(--color-dlabs-gray-200);
    padding: 0.25rem 2rem 0.15rem 0;
    font-size: var(--text-xs);
    outline: none;
    background: none;
  }

  .search-input:focus {
    border-bottom-color: var(--color-dlabs-blue);
  }

  .toolbar-button {
    border: 2px solid var(--color-dlabs-gray-200);
    background: none;
    cursor: pointer;
    font-family: var(--font-heading);
    font-size: var(--text-xs);
    font-weight: bold;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    transition-property: border-color, color;
  }

  .toolbar-button:hover {
    border-color: var(--color-dlabs-blue);
    color: var(--color-dlabs-blue);
  }

  /* Was .service-carousel-indicator + .button-transparent. */
  .filter {
    border: none;
    background: none;
    padding: 0.2rem;
    margin: -0.2rem;
    cursor: pointer;
    text-align: left;
    color: var(--color-black);
    opacity: 0.55;
    transition-property: opacity, color;
  }

  .filter:hover {
    opacity: 1;
  }

  .filter[data-active] {
    opacity: 1;
    font-weight: bold;
  }

  .tile-link {
    color: inherit;
    text-decoration: none;
    transition-property: color;
  }

  .tile-link:hover {
    color: var(--color-dlabs-blue);
  }
</style>

<script>
  import { setupMethodBrowser } from "./method-browser";
  setupMethodBrowser();
</script>
