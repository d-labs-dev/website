---
import type { CollectionEntry } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Button from "@/components/Button.astro";
import LeadLine from "@/components/LeadLine.astro";
import Markdown from "@/components/Markdown.astro";
import Contact from "@/components/Contact.astro";
import { contentfulImage, assetAlt } from "@/lib/contentful-image";
import { getPageCopy, pageUrl, entryUrl, otherLocale, type Locale } from "@/lib/i18n";
import DownloadIcon from "@/assets/images/icons/icon-download.svg";
/*
 * Inlined, not an <Image>: the file carries `fill: currentColor`, so on the
 * original this mark takes its link's colour and follows it on hover. An <img>
 * cannot inherit `color`, which left every one of these stuck at its rest shade.
 */
import ArrowDown from "@/assets/images/icons/icon-arrow-down.svg";
import { Image } from "astro:assets";

interface Props {
  entry: CollectionEntry<"jobs">;
  counterpartSlug: string | null;
}

const { entry, counterpartSlug } = Astro.props;
const job = entry.data;
const locale = job.locale as Locale;

const copy = await getPageCopy("jobs", locale);

const alternates = counterpartSlug
  ? [{ locale: otherLocale(locale), url: entryUrl("jobs", counterpartSlug, otherLocale(locale)) }]
  : [];

const jobsUrl = pageUrl("jobs", locale);
---

<BaseLayout
  title={job.title}
  description={job.firstParagraph}
  image={job.heroImage ? contentfulImage(job.heroImage, { width: 1200 }) : undefined}
  alternates={alternates}
>
  {/* Hero: image on the left, intro and apply circle on the right. */}
  {
    /*
    `height-screen` is unconditional on the old hero, and `justify-center`
    only takes over from `q-lg-justify-stretch` above 800px. Applied at `md:`
    the hero was 147px short of the viewport below 800.
  */
  }
  <div class="relative flex min-h-screen flex-col justify-stretch pt-16 md:justify-center md:pt-0">
    <div class="flex flex-auto flex-col gap-6 md:flex-initial md:flex-row md:gap-0">
      <div class="relative aspect-video md:aspect-auto md:min-h-[25rem] md:w-[calc(50%-6rem)]">
        {
          job.heroImage && (
            <img
              src={contentfulImage(job.heroImage, { width: 800 })}
              alt={assetAlt(job.heroImage)}
              class="absolute inset-0 h-full w-full object-cover"
              loading="eager"
            />
          )
        }
      </div>

      <div class="flex w-full flex-auto flex-col md:w-auto">
        {
          /*
          `sp-4` is a margin-bottom on every child but the last *and* the `.push`,
          so this column carries two 1.5rem gaps, not the three a flex `gap` puts
          between four children — 25px of extra height across the hero column.
        */
        }
        <div
          class="flex w-full max-w-[50rem] flex-auto flex-col px-6 md:max-w-[30rem] md:px-0 md:pl-12"
        >
          <Button variant="text" color="black" href={`${jobsUrl}#list`} class="mb-6">
            ←&nbsp;&nbsp;{copy.back_button_label}
          </Button>

          <div class="flex-auto"></div>

          <div class="mb-6 flex flex-col gap-4">
            <h1 class="font-heading tracking-heading text-xl sm:text-2xl">
              {job.title}<a
                href={`${jobsUrl}#inclusivity`}
                class="text-dlabs-blue hover:text-dlabs-dark-blue transition-colors"
                aria-label={copy.inclusivity_aria_label}>*</a
              >
            </h1>
            <h2 class="font-heading tracking-heading text-xl">
              <Markdown source={job.location} inline />
            </h2>
            <Markdown source={job.firstParagraph} size="sm" />
          </div>

          <div class="hidden justify-end overflow-visible pr-12 md:flex">
            <Button
              variant="circle"
              color="black"
              href={copy.apply_now_target}
              aria-label={copy.apply_now_aria_label}
            >
              {
                /*
                `pb-t1` on the original: 0.25rem under the label, which lifts it
                2px above the circle's centre. Without it the two lines sit dead
                centre and read as slightly low against live.
              */
              }
              <span class="block pb-1">{copy.circle_apply_now_button_label}</span>
            </Button>
          </div>
        </div>
      </div>
    </div>

    {
      /*
      The label is a plain `.button-text` — black, not blue. The original wraps
      this pair in an unclosed `<a class="button-text is-blue">`, which the parser
      turns into two empty anchors that pick up nothing; the visible link inside
      has no `is-blue`.
    */
    }
    <div class="absolute inset-x-0 bottom-0 hidden flex-col items-center gap-[1.2rem] pb-8 md:flex">
      <Button variant="text" color="black" href="#next">{copy.learn_more}</Button>
      {
        /*
        A real `.button-text`, so the mark is black at rest and turns blue on hover
        and focus like the label above it. As a bare anchor it had no colour of its
        own and no hover state at all.
      */
      }
      <Button variant="text" color="black" href="#next" aria-hidden="true" tabindex="-1">
        <ArrowDown class="inline w-4 fill-current align-baseline" aria-hidden="true" />
      </Button>
    </div>
  </div>

  {/* Profile and tasks */}
  <div id="next" class="flex flex-col items-center px-6 py-16">
    <div class="w-full max-w-[60rem]">
      <LeadLine>{copy.you_are_missing}</LeadLine>
    </div>
    <div class="flex w-full flex-col pt-16 md:w-1/3">
      <div class="flex flex-col gap-6">
        <h3 class="font-heading text-sm uppercase">{copy.profile_heading}</h3>
        <Markdown source={job.profile} size="sm" />
      </div>
      <div class="flex flex-col gap-6 pt-16">
        <h3 class="font-heading text-sm uppercase">{copy.tasks_heading}</h3>
        <Markdown source={job.tasks} size="sm" />
      </div>
    </div>
  </div>

  {/* Apply call to action */}
  <div class="bg-dlabs-blue flex flex-col items-center px-6 py-16">
    <div class="flex w-full max-w-[20rem] flex-col items-center gap-8">
      <h2 class="font-heading tracking-heading text-center text-lg text-white sm:text-xl">
        {job.secondHeadline}
      </h2>
      <div class="text-center">
        <Markdown source={job.secondParagraph} size="sm" tone="on-dark" />
      </div>
      <Button variant="solid" color="black" size="wide" href={copy.apply_now_target}>
        {copy.apply_now_button_label}
      </Button>
    </div>
  </div>

  {/* Closing note and PDF download */}
  <div class="flex flex-col items-center px-6 py-16">
    <div class="flex w-full max-w-[30rem] flex-col items-center gap-12">
      <Markdown source={job.thirdParagraph} class="font-medium" />
      {
        job.posting && (
          <Button variant="text" color="blue" href={job.posting.url} target="_blank" rel="noopener">
            <span class="flex items-center gap-3">
              <DownloadIcon class="w-4 fill-current" aria-hidden="true" />
              <span>{copy.download_button_label}</span>
            </span>
          </Button>
        )
      }
    </div>
  </div>

  {
    /*
    The contact block, which was missing from this page entirely — the old layout
    ends with `include contact.html contact=_.contact is_white=true
    no_button=true`: the light variant, and the details without the mail button
    because the apply call to action above already covers it.
  */
  }
  <Contact locale={locale} contact={copy.contact} light={true} withButton={false} />
</BaseLayout>
