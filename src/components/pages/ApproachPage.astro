---
/**
 * Approach: an intro, the scroll-driven diagram with seven captions over it, then
 * three project case studies, then the contact block.
 */
import { Image } from "astro:assets";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Button from "@/components/Button.astro";
import LeadLine from "@/components/LeadLine.astro";
import Markdown from "@/components/Markdown.astro";
import Contact from "@/components/Contact.astro";
import ApproachDiagram from "@/components/approach/ApproachDiagram.astro";
/*
 * Inlined, not an <Image>: the file carries `fill: currentColor`, so on the
 * original this mark takes its link's colour and follows it on hover. An <img>
 * cannot inherit `color`, which left every one of these stuck at its rest shade.
 */
import ArrowDown from "@/assets/images/icons/icon-arrow-down.svg";
import { getPageCopy, pageUrl, otherLocale, type Locale } from "@/lib/i18n";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = await getPageCopy("approach", locale);

const images = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/images/projects/*.{jpg,jpeg,png,webp,svg}",
  { eager: true },
);

function resolve(path: string) {
  const image = images[`/src/assets/images/${path}`]?.default;
  if (!image) throw new Error(`Approach project image not found: src/assets/images/${path}`);
  return image;
}

/** Task type -> brand colour. Mapped explicitly so Tailwind sees the class names. */
const TASK_COLOURS: Record<string, string> = {
  yellow: "text-dlabs-yellow",
  darkBlue: "text-dlabs-dark-blue",
  red: "text-dlabs-red",
  green: "text-dlabs-green",
  purple: "text-dlabs-purple",
};

const TASK_TYPES: Record<string, string> = {
  user_research: "yellow",
  design: "darkBlue",
  engineering: "red",
  training: "green",
  consulting: "purple",
};

const screens = copy.screens as { title: string; text?: string }[];
const projects = copy.projects as {
  lead: string;
  img1: string;
  img2: string;
  circle_img: string;
  percentages: Record<string, number>;
  task: string;
  goals: string[];
  approaches: string[];
  results: string[];
  image_source?: string;
}[];

const alternates = [{ locale: otherLocale(locale), url: pageUrl("approach", otherLocale(locale)) }];
---

<BaseLayout
  title={copy.seo_title ?? copy.intro_lead}
  description={copy.seo_description ?? copy.intro_text}
  activeRef="approach"
  alternates={alternates}
>
  <div class="relative" data-approach-scroll>
    {/* Intro */}
    <div
      class="relative z-1 flex min-h-screen flex-col items-center justify-center overflow-hidden px-6 py-16"
    >
      <div class="relative z-1 flex w-full max-w-[60rem] flex-col gap-6 pb-12">
        <LeadLine>{copy.intro_lead}</LeadLine>
        {/* `text-xxl q-md-text-xl`: one step at 640px, unlike the services intro. */}
        <div class="font-heading tracking-heading text-xl sm:text-2xl">
          <Markdown source={copy.intro_text} size="inherit" heading />
        </div>
      </div>

      {
        /*
        The circle that opens the page: a small blue ring behind the copy that
        expands past the viewport shortly after load. It was missing entirely.
      */
      }
      <div class="pointer-events-none absolute inset-0 flex flex-col">
        <div class="approach-circle" data-approach-circle></div>
      </div>

      <div class="absolute inset-x-0 bottom-0 z-1 flex flex-col items-center pb-6 text-black">
        {
          /*
          `sp-3` is a margin-bottom of 1rem that replaces `.button-text`'s -0.2rem
          on that side, while the mark below keeps its own — so the two sit 0.8rem
          apart. A flex `gap` adds to both negative margins instead of replacing
          one, so it needs 1.2rem to leave the same 0.8rem.
        */
        }
        <div class="flex flex-col items-center gap-[1.2rem]">
          <Button variant="text" color="black" href="#n1">{copy.intro_cta_text}</Button>
          <Button variant="text" color="black" href="#n1" aria-hidden="true" tabindex="-1">
            <ArrowDown class="inline w-4 fill-current align-baseline" aria-hidden="true" />
          </Button>
        </div>
      </div>
    </div>

    {/* The diagram, pinned, with the captions over it */}
    <div class="relative" style="padding-bottom: 40vh">
      <div class="pointer-events-none absolute inset-0 z-1 flex flex-col items-center">
        <div
          class="sticky top-0 flex min-h-screen w-full max-w-[80rem] flex-row items-end overflow-hidden pb-16 md:items-center md:pb-0"
        >
          <ApproachDiagram />

          {
            /*
            The link down to the project examples, which was missing — the old
            markup hangs it off the bottom of the diagram's sticky wrapper. Its
            copy is `projects_link_text`, which was in the content all along with
            nothing rendering it.
          */
          }
          <div
            class="pointer-events-none absolute inset-x-0 bottom-0 flex flex-col items-center pb-3 sm:pb-6"
          >
            <div class="pointer-events-auto flex flex-col items-center gap-[1.2rem]">
              <Button variant="text" color="black" href="#projects">
                {copy.projects_link_text}
              </Button>
              <Button
                variant="text"
                color="black"
                href="#projects"
                aria-hidden="true"
                tabindex="-1"
              >
                <ArrowDown class="inline w-4 fill-current align-baseline" aria-hidden="true" />
              </Button>
            </div>
          </div>
        </div>
      </div>

      <div class="pointer-events-none absolute inset-0 z-1 flex flex-col items-center">
        <div class="sticky top-0 min-h-screen w-full max-w-[60rem] px-6 pt-24">
          <LeadLine>{copy.slider_lead}</LeadLine>
        </div>
      </div>

      <div class="h-8" data-keyframe-marker></div>
      {
        screens.map((_, i) => (
          <div class="h-[20rem] sm:h-[25rem]" id={`n${i + 1}`} data-keyframe-marker />
        ))
      }

      {
        screens.map((screen, i) => (
          <div
            class="pointer-events-none absolute inset-0"
            style="opacity: 0"
            data-approach-screen={i}
          >
            <div class="sticky top-0 flex min-h-screen flex-col items-center px-6">
              <div class="w-full max-w-[60rem]">
                <div class="relative flex min-h-[60vh] flex-col gap-6 pt-24 pb-16">
                  <h2 class="font-heading tracking-heading pt-8 text-base sm:text-xl">
                    {screen.title}
                  </h2>
                  {screen.text && (
                    <div class="max-w-[25rem] text-xs sm:max-w-[15rem] sm:text-base">
                      {screen.text}
                    </div>
                  )}
                </div>
              </div>
            </div>
          </div>
        ))
      }

      <div class="absolute inset-y-0 right-0 z-1 hidden md:block">
        <div class="sticky top-0 flex min-h-screen flex-col justify-center gap-4 pr-4">
          {
            screens.map((_, i) => (
              <a
                href={`#n${i + 1}`}
                class="screen-dot"
                data-approach-indicator={i}
                aria-label={`${locale === "de" ? "Seite" : "Screen"} ${i + 1}`}
              />
            ))
          }
        </div>
      </div>
    </div>
  </div>

  {/* Projects */}
  <div id="projects" class="flex flex-col items-center px-6 pt-24 pb-16">
    <div class="flex w-full max-w-[60rem] flex-col gap-12">
      <h2 class="font-heading tracking-heading max-w-[30rem] text-xl">{copy.projects_title}</h2>

      <div class="flex flex-col gap-24">
        {
          projects.map((project, index) => (
            <div class="flex flex-col" id={`project${index + 1}`}>
              <div class="pb-6">
                <LeadLine>{project.lead}</LeadLine>
              </div>

              <div class="flex h-40 flex-row gap-4 sm:h-[30rem]">
                <div class="relative w-1/3 shrink-0 sm:w-[15rem]">
                  <Image
                    src={resolve(project.img1)}
                    alt=""
                    class="absolute inset-0 h-full w-full object-cover"
                    loading="lazy"
                  />
                </div>
                <div class="relative flex-auto">
                  <Image
                    src={resolve(project.img2)}
                    alt=""
                    class="absolute inset-0 h-full w-full object-cover"
                    loading="lazy"
                  />
                </div>
              </div>

              <div class="relative flex flex-col items-center gap-4 sm:flex-row sm:items-start">
                <div class="relative flex w-[15rem] shrink-0 flex-col items-center gap-8 py-3 sm:sticky sm:top-0 sm:pt-16 sm:pb-8">
                  <Image src={resolve(project.circle_img)} alt="" class="w-full" loading="lazy" />

                  <div class="flex flex-col gap-3">
                    {Object.entries(TASK_TYPES).map(([key, colour]) => {
                      const percentage = project.percentages[key] ?? 0;
                      if (percentage === 0) return null;
                      return (
                        <div
                          class:list={[
                            "font-heading flex flex-row gap-2 text-xs",
                            TASK_COLOURS[colour],
                          ]}
                        >
                          <div class="w-6 text-right">{percentage}%</div>
                          <div>{copy[key]}</div>
                        </div>
                      );
                    })}
                  </div>
                </div>

                <div class="relative flex flex-auto flex-col gap-8 pt-16 max-sm:py-6">
                  <h3 class="font-heading tracking-heading max-w-[30rem] text-xl">
                    {project.task}
                  </h3>

                  {(
                    [
                      [copy.projects_goal_title, project.goals],
                      [copy.projects_approach_title, project.approaches],
                      [copy.projects_result_title, project.results],
                    ] as [string, string[]][]
                  ).map(([heading, items]) => (
                    <div class="flex flex-col gap-6">
                      <h4 class="font-heading text-xs uppercase">{heading}</h4>
                      <ul class="bullet-list flex flex-col gap-3">
                        {items.map((item) => (
                          <li class="prose max-w-none">
                            <Markdown source={item} inline />
                          </li>
                        ))}
                      </ul>
                    </div>
                  ))}

                  {/*
                    Always rendered, empty or not: `.approach-project-image_source`
                    is an unconditional element in the original, so it contributes
                    a 2rem column gap on the two projects that have no credit.
                  */}
                  <div class="image-source">{project.image_source}</div>
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>

  <Contact locale={locale} contact={copy.contact} light={true} />
</BaseLayout>

<style>
  /*
   * The intro circle. Values are the original's: a 20vmax ring that starts at a
   * tenth of its size with a thick border and grows to ten times with a thin one,
   * over 0.75s. `margin: auto` centres it in the absolutely-positioned wrapper.
   */
  .approach-circle {
    margin: auto;
    width: 20vmax;
    height: 20vmax;
    border-radius: 50%;
    border: 15px solid var(--color-dlabs-blue);
    transform: translate3d(0, 33%, 0) scale(0.1);
    transition: transform 0.75s ease-out;
  }

  .approach-circle[data-grown] {
    border-width: 2px;
    transform: translate3d(0, 33%, 0) scale(10);
  }

  /*
   * `.approach-project-image_source`. The size is a fluid calc rather than a
   * token, so it stays CSS: `text-2xs` would be 0.32px off at 1280.
   */
  .image-source {
    font-size: calc(0.45em + 0.4vw);
    color: var(--color-dlabs-gray-300);
  }

  .screen-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background-color: var(--color-dlabs-gray-200);
    transition-property: background-color, transform;
  }

  .screen-dot:hover {
    background-color: var(--color-dlabs-gray-300);
  }

  .screen-dot[data-active] {
    background-color: var(--color-dlabs-blue);
    transform: scale(1.4);
  }
</style>

<script>
  import { setupApproach, setupApproachCircle } from "@/components/approach/approach";
  setupApproach();
  setupApproachCircle();
</script>
