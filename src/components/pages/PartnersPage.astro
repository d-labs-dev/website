---
/**
 * Partner network: a short intro and a wrapped grid of partner logos.
 */
import { getEntry } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Markdown from "@/components/Markdown.astro";
import { getPageCopy, pageUrl, otherLocale, type Locale } from "@/lib/i18n";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = await getPageCopy("partners", locale);

const entry = await getEntry("partners", "partners");
const partners = entry?.data.partners ?? [];

const logos = import.meta.glob<{ default: ImageMetadata }>("/src/assets/images/**/*.svg", {
  eager: true,
});

const alternates = [{ locale: otherLocale(locale), url: pageUrl("partners", otherLocale(locale)) }];
---

<BaseLayout
  title={copy.title}
  description={copy.content}
  activeRef="partners"
  alternates={alternates}
>
  <article class="flex flex-col items-center px-6 py-12 pt-24">
    <div class="flex w-full max-w-[40rem] flex-col gap-8 pt-12">
      {
        /*
        Title and body are one prose block, as in the original: that is where the
        h1 gets its 1.8rem size and 3rem bottom margin. Routing the heading
        through the markdown pipeline rather than hand-writing it keeps those
        metrics in one place instead of two.
      */
      }
      <Markdown source={`# ${copy.title}\n\n${copy.content}`} />

      <div class="flex flex-row flex-wrap items-center">
        {
          partners.map((partner) => {
            const logo = logos[`/src/assets/images/${partner.logo}`]?.default;
            if (!logo) {
              throw new Error(`Partner logo not found: src/assets/images/${partner.logo}`);
            }
            return (
              <a
                href={partner.link}
                target="_blank"
                rel="noopener noreferrer"
                title={partner.name}
                class:list={[
                  "flex w-1/2 items-center justify-center py-6 transition-opacity hover:opacity-70 md:w-1/3",
                  partner.padding,
                ]}
              >
                {/*
                  `w-full`, no height cap. `full-width maxheight-6` in the old
                  markup match no rule, but these SVGs declare no width, so a
                  bare <img> fills its box — see the note in ClientCarousel.
                */}
                <Image src={logo} alt={partner.name} class="w-full" />
              </a>
            );
          })
        }
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  /*
   * 3rem under the title, which is what live renders. The old `.markdown` sets
   * `h1 { margin-bottom: 3rem }` but also `h1:not(:last-child) { margin-bottom:
   * 1rem }`, and the more specific rule usually wins — except here, where the
   * intro copy is emitted as a bare text node rather than a paragraph, so the h1
   * *is* the last element child. The copy belongs in a <p>, so the spacing is
   * restored explicitly rather than by dropping the markup.
   */
  article :global(.prose h1) {
    margin-bottom: 3rem;
  }
</style>
