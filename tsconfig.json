{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  // `_site`, `assets` and `vendor` are the Jekyll site, which is not ours to check.
  "exclude": ["dist", "_site", "assets", "node_modules"],
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    }
  }
}
